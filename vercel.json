{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "echo 'No build step: public/ is prebuilt, api/index.js runs server.js'",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/(api/.*|health|elapsed-config\\.json)", "destination": "/api" },
    { "source": "/([^.]*)", "destination": "/index.html" }
  ]
}
